# AI provider selection
AI_PROVIDER=heuristics
USE_MOCK=false

# Heuristics LLM gateway (DeepSeek V4 via LiteLLM)
HEURISTICS_BASE_URL=http://localhost:4000
HEURISTICS_API_KEY=sk-litellm-local-dev
HEURISTICS_MODEL=deepseek-v4-flash
HEURISTICS_FALLBACK_MODEL=deepseek-v4-flash

# Provider credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks after OPENROUTER_MODEL.
OPENROUTER_MODELS=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=radio-passport

# Enable feature previews
# Experimental Raptor mini compact player; default disabled locally. When set to
# `true`, the app renders the new compact 'Raptor' mini player variant on mobile
# as a preview for all clients.
ENABLE_RAPTOR_MINI=false
