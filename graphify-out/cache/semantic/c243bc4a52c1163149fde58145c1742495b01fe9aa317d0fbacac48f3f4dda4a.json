{"nodes": [{"id": "design_handoff_radio_passport_readme_doc", "label": "Handoff README: Radio Passport Redesign", "file_type": "document", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_signal_and_stamp", "label": "Signal & Stamp Aesthetic", "file_type": "rationale", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One nocturnal shortwave system replaces mixed legacy styles (retro tuner, neumorphic tab bar, beige Mantine theme, AI-generated imagery). High fidelity: recreate pixel-perfectly in Remix/React/Tailwind, wiring demo data to the real Radio Browser catalog."}, {"id": "readme_design_tokens", "label": "Design Tokens (charcoal/paper/coral/teal, Sora + IBM Plex Mono)", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "charcoal #14120F background, surface #1C1915, paper #F2EDE4 text, muted #A89F90, coral #E5535F the ONLY accent, signal teal #6FB5C4 on-air status only; dashed 1.5px border = perforation motif for anything passport-related; Sora for display/UI, IBM Plex Mono for telemetry."}, {"id": "readme_particle_globe_spec", "label": "Particle Globe Spec", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~300 background particles on a fibonacci sphere, rotation 0.0022 rad/frame pausing on city hover, front-hemisphere coral city dots, playing city in signal teal with pulse, canvas-drawn tooltip, ~30 prominent dots max, DPR<=2, pause when document.hidden, respect reduced motion."}, {"id": "readme_atlas_overlay_spec", "label": "Atlas Overlay Spec (country index)", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen 44-country index in six regions; country/language search; language shown as a first-class facet on every row; drill-down groups stations under city eyebrows with Top Picks for big countries, never a flat 2,000-row list."}, {"id": "readme_passport_view_spec", "label": "Passport View Spec (stats + stamp grid)", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stamp_mechanic", "label": "Stamp Mechanic (dwell-to-ink)", "file_type": "rationale", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listening to a station in an unstamped city for 60 seconds (prototype tweak: 15s) inks the stamp and fires a bottom-right PASSPORT STAMPED toast; timer cancels on station change or pause; 'Stay long enough to be stamped.'"}, {"id": "readme_player_dock_spec", "label": "Single Player Dock Spec", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One dock everywhere replaces separate mini/premium/compact player variants; artwork is a live particle-ring canvas whose orbit radius tracks amplitude, hue seeded from station id."}, {"id": "readme_state_management", "label": "Prototype State Model (mode/mood/place/stamps/played)", "file_type": "concept", "source_file": "design_handoff_radio_passport/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale