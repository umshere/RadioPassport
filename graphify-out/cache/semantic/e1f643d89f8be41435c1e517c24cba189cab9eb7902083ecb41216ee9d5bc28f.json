{"nodes": [{"id": "design_handoff_radio_passport_design_system_doc", "label": "Signal & Stamp Design System (dc.html reference)", "file_type": "document", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_logo_mark", "label": "Logo Mark: a stamp that broadcasts", "file_type": "concept", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perforated coral stamp ring + transmitter dot + two signal arcs; reads as a passport stamp at rest and a live antenna in motion. Coral arc = you; paper arc = the world answering."}, {"id": "design_system_one_accent_rule", "label": "One Accent Color Rule", "file_type": "rationale", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coral carries every interactive and live moment; signal teal reserved for on-air status only; everything else charcoal and paper - no gradients as decoration, no purple glows, no beige surfaces."}, {"id": "design_system_particles_not_pictures", "label": "Particles, Not Pictures", "file_type": "rationale", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every station gets generative artwork: station ID seeds a hue and a particle ring, playback drives amplitude. Replaces AI-generated images entirely - zero asset cost, consistent identity, cheap 2D canvas on mobile. Caps: ~max 300 particles, DPR<=2, pause when tab hidden, respect reduced motion."}, {"id": "design_system_scale_model", "label": "Content Scale Model (chips vs Atlas)", "file_type": "rationale", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chips are shortcuts (near you, featured, recent) never the taxonomy; the Atlas (region -> country -> top stations) is the canonical index for 100+ countries; language is searchable and first-class; the globe is a complement capped at ~30 brightest signals - it invites, Atlas and search deliver breadth."}, {"id": "design_system_type_system", "label": "Type System (Sora display, Plex Mono telemetry)", "file_type": "concept", "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_system_one_accent_rule", "target": "readme_design_tokens", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_system_particles_not_pictures", "target": "readme_particle_globe_spec", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_system_scale_model", "target": "readme_atlas_overlay_spec", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_handoff_radio_passport_design_system_doc", "target": "design_system_logo_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_handoff_radio_passport_design_system_doc", "target": "design_system_one_accent_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_handoff_radio_passport_design_system_doc", "target": "design_system_particles_not_pictures", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_handoff_radio_passport_design_system_doc", "target": "design_system_scale_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_handoff_radio_passport_design_system_doc", "target": "design_system_type_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_system_type_system", "target": "readme_design_tokens", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "design_handoff_radio_passport/Design System.dc.html", "source_location": null, "weight": 1.0}], "hyperedges": []}