{"nodes": [{"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_doc", "label": "Claude Handoff: Discovery Filters, Search Clarity, Station Availability", "file_type": "document", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_filter_state_problem", "label": "Hidden Filter State Problem", "file_type": "concept", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mood/place chips hide toggle-off semantics, switching MOOD/PLACE preserves the previous value invisibly, text queries are ANDed with lingering filters, and empty results never explain which constraint caused them - the state feels locked."}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_interaction_contract", "label": "Filter Interaction Contract (All moods / All places / Clear search)", "file_type": "rationale", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One obvious model: MOOD and PLACE mutually exclusive with explicit All moods / All places reset chips; free-text search global and taking precedence (prefer clearing constraints); visible Clear search affordance; accessible aria-pressed state, 44px targets, reduced-motion compatibility."}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_url_query_hydration", "label": "?q= Deep Link Hydration", "file_type": "concept", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_typo_recovery", "label": "Modest Typo Recovery (trans -> trance)", "file_type": "concept", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add typo/prefix recovery for common music vocabulary ('trans' should suggest trance) without broad fuzzy matching that floods results with irrelevant stations."}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_station_availability_honesty", "label": "Station Availability Honesty (no stale Healthy labels)", "file_type": "rationale", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never call a station Healthy solely from stale catalog metadata (phase two showed checks ~7 months old); represent evidence age honestly, e.g. 'Not recently verified'; prefer recently verified stations in ranking."}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_live_probe_strategy", "label": "Bounded Live Probe Shelf (server/stations/probe.ts)", "file_type": "concept", "source_file": "design_handoff_radio_passport/CLAUDE_FILTER_SEARCH_AVAILABILITY_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live-probe only a bounded leading shelf with concurrency limits, short timeouts, caching and SSR/Vercel safety; reuse server/stations/probe.ts but verify its HEAD/Range strategy against streaming endpoints."}, {"id": "design_handoff_radio_passport_claude_filter_search_availability_handoff_autoskip_transparency", "label": "Auto-Skip 